[Unit]
Description=NMKR Midnight Paywindow (%i)
After=network-online.target nmkr-api@mainnet.service
Wants=network-online.target

[Service]
Type=simple
User=nmkr
Group=nmkr
WorkingDirectory=/opt/nmkr/nmkr-paywindow-%i
EnvironmentFile=/etc/nmkr/paywindow-%i.env
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/nmkr/paywindow-%i.log
StandardError=append:/var/log/nmkr/paywindow-%i.log

[Install]
WantedBy=multi-user.target
