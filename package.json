{
  "name": "nmkr-midnight-api",
  "version": "1.1.0",
  "type": "module",
  "description": "REST API for the Midnight Network \u2014 wallet management, NIGHT transfers, NFT minting with Swagger UI",
  "scripts": {
    "api": "NODE_OPTIONS=--max-old-space-size=16384 tsx src/api/server.ts",
    "api:preprod": "NODE_OPTIONS=--max-old-space-size=32768 MIDNIGHT_NETWORK=preprod tsx src/api/server.ts",
    "api:preview": "NODE_OPTIONS=--max-old-space-size=16384 MIDNIGHT_NETWORK=preview tsx src/api/server.ts",
    "api:mainnet": "NODE_OPTIONS=--max-old-space-size=16384 MIDNIGHT_NETWORK=mainnet tsx src/api/server.ts",
    "compile": "compactc --skip-zk contracts/nmkr-nft.compact contracts/managed/nmkr-nft",
    "proof-server": "docker run -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^17.0.0",
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/wallet-sdk": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "4.0.0",
    "@midnightntwrk/ledger-v8": "8.1.3",
    "@midnightntwrk/ledger-v9": "1.0.1",
    "bip39": "^3.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mysql2": "^3.22.3",
    "rxjs": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.19.0"
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@midnightntwrk/ledger-v8": "8.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
